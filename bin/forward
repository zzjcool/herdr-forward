# --- watch ---

# cmd_watch — pane 入口。TTY 下进交互式 Port Forward 面板（lib/panel.sh，M3）；
# 非 TTY 一律退化为旧行为 `watch -n 3 forward list`。
#
# 为什么必须退化（向后兼容，不是偷懒）：
#   * 脚本化调用 / CI / E2E 会把 stdin 重定向（或根本没有 stdin），此时 read -n 1
#     没有输入源，真交互循环会空转到 EOF 或直接干扰输出解析；
#   * 面板模块缺失（旧检出 / 部分安装）时 watch 路径仍然可用 —— 松散耦合。
cmd_watch() {
  if [[ -t 0 && -f "${FORWARD_LIB}/panel.sh" ]]; then
    # shellcheck source=/dev/null
    source "${FORWARD_LIB}/panel.sh"
    if declare -F panel_main >/dev/null 2>&1; then
      local panel_rc=0
      set +o errexit
      panel_main
      panel_rc=$?
      set -o errexit
      if [[ "${panel_rc}" -eq 0 ]]; then
        return 0
      fi
      log warn "交互面板未接管（rc=${panel_rc}），退化为 'watch -n 3 forward list'。"
    fi
  fi

  require_cmd watch "watch 命令缺失。请安装 procps/util-linux，或直接运行 'forward list'。"
  exec watch -n 3 "${FORWARD_ROOT}/bin/forward" list
}

# --- bootstrap（OOTB 子命令） ---

# cmd_bootstrap：把参数原样转发给 scripts/bootstrap.sh（单一实现，CLI 只是入口）。
# 该脚本负责 tab bar + 键位的幂等安装与后续指引；缺脚本时给出可执行的下一步。
cmd_bootstrap() {
  local script="${FORWARD_ROOT}/scripts/bootstrap.sh"
  if [[ ! -f "${script}" ]]; then
    die 127 "缺少 ${script}（OOTB 安装脚本）。本机手动安装：bash scripts/install-tabbar.sh && bash scripts/install-keys.sh。请确认插件检出完整后重试。"
  fi
  local rc=0
  bash "${script}" "$@" || rc=$?
  # 作为「Port Forward: Setup UI」action 运行时顺手重载，新装的键位与 tab bar 立即可用
  if ((rc == 0)) && declare -F _bridge_bounded >/dev/null; then
    local reloaded=""
    reloaded="$(_hf_reload_herdr)"
    if [[ ${reloaded} == "yes" ]]; then
      printf '已自动重载 herdr 配置：键位与 tab bar 已生效。\n'
    fi
  fi
  return "${rc}"
}

# --- bridge（A.3.3：client ↔ server 桥接） ---

_hf_bridge_require() {
  if ! declare -F bridge_serve >/dev/null; then
    die 127 "缺少 ${FORWARD_LIB}/bridge.sh（桥接模块）。请确认插件检出完整后重试（herdr plugin install zzjcool/herdr-forward --yes）。"
  fi
}

# _hf_default_plugin_state_dir -> stdout: herdr 给本插件分配的 state 目录（按 manifest id 推导）
#   经 SSH 调起的 `bridge serve` 不在插件上下文里；client 总会显式传 HERDR_PLUGIN_STATE_DIR，
#   这里只兜手动调用，避免落到与面板分叉的 ~/.local/state/herdr-forward。
_hf_default_plugin_state_dir() {
  local id="zzjcool:forward"
  local manifest="${FORWARD_ROOT}/herdr-plugin.toml"
  if [[ -f ${manifest} ]]; then
    local line=""
    while IFS= read -r line; do
      if [[ ${line} =~ ^[[:space:]]*id[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
        id="${BASH_REMATCH[1]}"
        break
      fi
    done <"${manifest}"
  fi
  printf '%s\n' "${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/herdr/plugins/${id//:/%3A}"
}

cmd_bridge_status() {
  local json=""
  if [[ ${1-} == "--json" ]]; then
    json="yes"
    shift
  fi
  if (($# > 0)); then
    die "${EXIT_USAGE}" "用法：forward bridge status [--json]"
  fi
  local clients="" sessions=""
  clients="$(bridge_clients_json)"
  sessions="$(bridge_sessions_json)"
  if [[ -n ${json} ]]; then
    jq -c -n --argjson c "${clients}" --argjson s "${sessions}" '{clients: $c, sessions: $s}'
    return 0
  fi
  local rows=""
  printf '本机作为 client（把远端端口映射到本机 localhost）：\n'
  rows="$(printf '%s' "${clients}" | jq -r '
    .[] | "  \(.label // .machine)  \(.target)  " +
      (if .running | not then "未运行" else .state end) +
      (if (.reason // "") != "" and .state != "connected" then "（\(.reason)）" else "" end) +
      "  映射 \([.forwards[]? | select(.state == "up")] | length)/\([.forwards[]?] | length)"
  ')"
  printf '%s\n' "${rows:-  （无）}"
  printf '本机作为 server（client 经桥接 attach 进来）：\n'
  rows="$(printf '%s' "${sessions}" | jq -r '
    .[] | "  client \(.client_host // "?")（\(.client_label // "")）" +
      (if .live then "在线" else "心跳超时" end) +
      "  映射 up \([.status[]? | select(.state == "up")] | length)"
  ')"
  printf '%s\n' "${rows:-  （无）}"
}

cmd_bridge() {
  _hf_bridge_require
  if (($# == 0)); then
    die "${EXIT_USAGE}" "缺少 bridge 子命令。用法：forward bridge up|down|status|serve|run"
  fi
  local sub="$1"
  shift
  case "${sub}" in
  serve)
    if [[ -z ${HERDR_PLUGIN_STATE_DIR:-} ]]; then
      HERDR_PLUGIN_STATE_DIR="$(_hf_default_plugin_state_dir)"
      export HERDR_PLUGIN_STATE_DIR
    fi
    bridge_serve
    ;;
  run)
    (($# == 1)) || die "${EXIT_USAGE}" "用法：forward bridge run <machine-id>"
    bridge_run "$1"
    ;;
  up)
    (($# == 1)) || die "${EXIT_USAGE}" "用法：forward bridge up <machine-id>"
    bridge_up "$1" "${FORWARD_ROOT}/bin/forward"
    ;;
  down)
    (($# == 1)) || die "${EXIT_USAGE}" "用法：forward bridge down <machine-id|all>"
    if [[ $1 == "all" ]]; then
      local mids="" mid=""
      mids="$(bridge_clients_json | jq -r '.[].machine')"
      while IFS= read -r mid; do
        [[ -n ${mid} ]] || continue
        bridge_down "${mid}"
      done <<<"${mids}"
    else
      bridge_down "$1"
    fi
    ;;
  status) cmd_bridge_status "$@" ;;
  *) die "${EXIT_USAGE}" "未知 bridge 子命令：${sub}。可用：up / down / status / serve / run。" ;;
  esac
}

# --- ports ---

cmd_ports() {
  if ! declare -F ports_listening_json >/dev/null; then
    die 127 "缺少 ${FORWARD_LIB}/ports.sh。请确认插件检出完整后重试。"
  fi
  local ports=""
  ports="$(ports_listening_json)"
  if [[ ${1-} == "--json" ]]; then
    printf '%s\n' "${ports}"
    return 0
  fi
  if (($# > 0)); then
    die "${EXIT_USAGE}" "用法：forward ports [--json]"
  fi
  local forwards=""
  forwards="$(forward_list_json)"
  printf '%-7s %-16s %-20s %s\n' "PORT" "ADDR" "PROCESS" "FORWARDED"
  local rows=""
  rows="$(jq -r -n --argjson p "${ports}" --argjson f "${forwards}" '
    ($f | map(select(.mode == "client") | {key: (.remote_port | tostring), value: .local_port}) | from_entries) as $m
    | $p[] | [(.port | tostring), .addr, (if .process == "" then "-" else .process end),
              (if $m[.port | tostring] then "client:\($m[.port | tostring])" else "-" end)] | @tsv
  ')"
  local row=""
  while IFS= read -r row; do
    [[ -n ${row} ]] || continue
    printf '%s\n' "${row}" | awk -F'\t' '{printf "%-7s %-16s %-20s %s\n", $1, $2, $3, $4}'
  done <<<"${rows}"
}

# --- open-url（link handler 的落点） ---

_hf_open_locally() {
  local url="${1-}"
  if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "${url}"
  elif command -v open >/dev/null 2>&1; then
    exec open "${url}"
  fi
  die 127 "本机没有 xdg-open/open，无法打开 ${url}。"
}

# cmd_open_url [url]：Ctrl+click localhost 链接。
#   有 client 经桥接在线 = 用户是从另一台机器 attach 进来的：本机浏览器对他没有意义，
#   于是确保该端口已映射到 client，再请 client 在它自己的浏览器里打开。
cmd_open_url() {
  local url="${1:-${HERDR_PLUGIN_CLICKED_URL:-}}"
  if [[ -z ${url} ]]; then
    die "${EXIT_USAGE}" "缺少 URL。用法：forward open-url http://localhost:3000"
  fi
  local live=""
  if declare -F bridge_any_live >/dev/null; then
    live="$(bridge_any_live)"
  fi
  if [[ ${live} != "yes" || ! ${url} =~ ^(https?)://(localhost|127\.0\.0\.1)(:([0-9]{1,5}))?(.*)$ ]]; then
    _hf_open_locally "${url}"
  fi
  local scheme="${BASH_REMATCH[1]}"
  local port="${BASH_REMATCH[4]}"
  local rest="${BASH_REMATCH[5]}"
  if [[ -z ${port} ]]; then
    port=80
    [[ ${scheme} == "https" ]] && port=443
  fi

  local forwards="" lp=""
  forwards="$(forward_list_json)"
  lp="$(printf '%s' "${forwards}" | jq -r --argjson rp "${port}" \
    'first(.[] | select(.mode == "client" and .remote_port == $rp) | .local_port) // empty')"
  if [[ -z ${lp} ]]; then
    lp="${port}"
    if ((lp < 1024)); then
      lp=$((port + 10000))
    fi
    local id_taken=""
    id_taken="$(printf '%s' "${forwards}" | jq -r --argjson lp "${lp}" 'any(.[]; .local_port == $lp) | tostring')"
    if [[ ${id_taken} == "true" ]]; then
      die 2 "本机映射表里端口 ${lp} 已被另一条记录占用，无法自动映射 ${url}。请用 forward add <空闲端口>:${port} --client 后再点击。"
    fi
    _hf_add_client "${lp}" "${port}" >/dev/null
  fi
  local target_url="${scheme}://localhost:${lp}${rest}"
  bridge_enqueue_open "${target_url}"
  if declare -F notify_toast >/dev/null; then
    notify_toast "Port Forward" "在 client 上打开 ${target_url}"
  fi
  printf '已请 client 打开 %s\n' "${target_url}"
}

# --- machines（herdr saved machines + 跨机激活；M2 归属） ---
#
# 归属声明：本段（cmd_machines / cmd_machines_list / cmd_machines_activate /
# cmd_machines_deactivate / cmd_machines_doctor 及 _hf_machines_* / _hf_install_* 助手）
# 归 M2。cmd_watch 的交互式面板改造归 M3，双方互不触碰（plan §4 的 bin/forward 函数块切割）。
# 契约见 machines-integration-plan §2.3；退出码沿用冻结表（3 记录不存在 / 4 探测或解析失败
# / 64 用法错误），另用 1 表示「探测通过但写记录/装 UI 失败」（冻结表未覆盖，见下面注释）。

# _hf_machines_available：stdout yes 表示数据层已加载（输出式，避免 SC2310）
_hf_machines_available() {
  _hf_has_func machines_view_json
}

# _hf_machines_require：数据层缺失 -> die 127（绝不静默降级成空输出）
_hf_machines_require() {
  local has=""
  has="$(_hf_machines_available)"
  if [[ -z "${has}" ]]; then
    die 127 "缺少 ${FORWARD_LIB}/machines.sh（machines 子命令的数据层）。请确认插件检出完整后重试（herdr plugin update）。"
  fi
}

# _hf_config_path：stdout herdr config.toml 路径
#   优先级与 scripts/startup-hook.sh 一致：$HERDR_CONFIG_PATH（herdr server 注入）> 默认。
_hf_config_path() {
  if [[ -n "${HERDR_CONFIG_PATH:-}" ]]; then
    printf '%s\n' "${HERDR_CONFIG_PATH}"
    return 0
  fi
  printf '%s\n' "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/herdr/config.toml"
}

# _hf_install_tabbar [plugin_root] [state_dir] -> 0 ok / 非 0 失败
#   不传参数 = 恢复本机路径（install-tabbar.sh 自动解析自身所在的插件根）。
#   安装器输出走 stderr：本函数用于 CLI 与（M3 的）面板共用，stdout 必须保持干净。
_hf_install_tabbar() {
  local plugin_root="${1-}"
  local state_dir="${2-}"
  local script="${FORWARD_ROOT}/scripts/install-tabbar.sh"
  if [[ ! -f "${script}" ]]; then
    log warn "缺少 ${script}，跳过 tab bar 更新。请手动运行：bash ${script}"
    return 0
  fi

  local -a args=("--config" "$(_hf_config_path)")
  if [[ -n "${plugin_root}" ]]; then
    args+=("--plugin-root" "${plugin_root}")
  fi
  if [[ -n "${state_dir}" ]]; then
    args+=("--state-dir" "${state_dir}")
  fi

  local rc=0
  set +o errexit
  bash "${script}" "${args[@]}" >&2
  rc=$?
  set -o errexit
  return "${rc}"
}

# _hf_install_keys -> 0 ok / 非 0 失败（同样保持 stdout 干净）
_hf_install_keys() {
  local script="${FORWARD_ROOT}/scripts/install-keys.sh"
  if [[ ! -f "${script}" ]]; then
    log warn "缺少 ${script}，跳过键位安装。请手动运行：bash ${script}"
    return 0
  fi
  local cfg=""
  cfg="$(_hf_config_path)"
  local rc=0
  set +o errexit
  bash "${script}" --config "${cfg}" >&2
  rc=$?
  set -o errexit
  return "${rc}"
}

# _hf_reload_herdr -> stdout "yes"（已重载本机 herdr server）/ 空
#   server 侧重载会把 tab bar 的变化推给已连接的 client（真 TUI 自动化测试实测），
#   用户不必再手动 reload-config。只在以 herdr 插件身份运行时做（HERDR_PLUGIN_ID
#   由 herdr 注入）：终端里手敲的命令 / 测试不去重载用户真实的 server。
_hf_reload_herdr() {
  [[ -n ${HERDR_PLUGIN_ID:-} && -n ${HERDR_BIN_PATH:-} ]] || return 0
  local rc=0
  set +o errexit
  _bridge_bounded 15 "${HERDR_BIN_PATH}" server reload-config >/dev/null 2>&1
  rc=$?
  set -o errexit
  if ((rc == 0)); then
    printf 'yes\n'
  fi
  return 0
}

# _hf_machines_reload_hint <target>：激活/停用后让 tab bar 生效（能自动重载就自动，否则告诉用户）
_hf_machines_reload_hint() {
  local target="${1-}"
  local reloaded=""
  if declare -F _bridge_bounded >/dev/null; then
    reloaded="$(_hf_reload_herdr)"
  fi
  if [[ ${reloaded} == "yes" ]]; then
    printf '\n已自动重载 herdr 配置：tab bar 已切换（它由 herdr server 执行，查看 %s 时读的是那台机器上的状态）。\n' "${target:-该机器}"
  else
    printf '\n下一步：在 herdr 里执行 reload-config（或重启 herdr）使 tab bar 生效。\n'
    printf '  tab bar command 由 herdr server 执行；跨机时它读的是 %s 上的插件与状态。\n' "${target:-该机器}"
  fi
  printf '  回滚：forward machines deactivate all\n'
}

cmd_machines_list() {
  _hf_machines_require

  local mode="table"
  while (($# > 0)); do
    case "$1" in
    --json)
      mode="json"
      shift
      ;;
    --short)
      mode="short"
      shift
      ;;
    -*)
      die "${EXIT_USAGE}" "未知参数：$1。用法：forward machines list [--json] [--short]"
      ;;
    *)
      die "${EXIT_USAGE}" "list 不接受位置参数：$1。用法：forward machines list [--json] [--short]"
      ;;
    esac
  done

  local view=""
  view="$(machines_view_json)"
  local fmt=""
  # 三态标记与 §2.3/§2.4 冻结一致：[✓] 当前 / [·] 曾激活 / [ ] 未激活 / [✓ local] 同机
  fmt='.[] | [
    (if .state == "active" then "[✓]"
     elif .state == "activated" then "[·]"
     elif .state == "local" then "[✓ local]"
     else "[ ]" end),
    .id,
    .label,
    (.target | if . == "" then "-" else . end),
    .state,
    (if .orphan then "saved machine 已删除（记录残留）" else "" end)
  ] | @tsv'

  case "${mode}" in
  json)
    printf '%s\n' "${view}" | jq -c '.'
    ;;
  short)
    # 面板消费：marker <TAB> id <TAB> label <TAB> target <TAB> state <TAB> orphan-note
    printf '%s\n' "${view}" | jq -r "${fmt}"
    ;;
  *)
    local count=""
    count="$(printf '%s' "${view}" | jq -r 'length')"
    if [[ "${count}" == "0" ]]; then
      printf '没有可用的 saved machines。\n'
      printf '  可能原因：herdr 里还没保存 machine（herdr machine add）；或本命令不是从 herdr 插件上下文调起的（HERDR_BIN_PATH 未注入，非插件运行时属正常）。\n'
      return 0
    fi
    printf '%-10s %-20s %-24s %-16s %s\n' "STATE" "ID" "LABEL" "TARGET" "NOTE"
    local rows=""
    set +o errexit
    rows="$(printf '%s' "${view}" | jq -r "${fmt}")"
    set -o errexit
    local row=""
    while IFS= read -r row; do
      [[ -z "${row}" ]] && continue
      printf '%s\n' "${row}" | awk -F'\t' '{printf "%-10s %-20s %-24s %-16s %s\n", $1, $2, $3, $4, $6}'
    done <<<"${rows}"
    printf '\n[✓] 当前激活  [·] 曾激活（可重新激活）  [ ] 未激活  [✓ local] 本机\n'
    printf '激活：forward machines activate <id|label>    停用：forward machines deactivate <id|all>\n'
    ;;
  esac
}

# _hf_machines_probe_fields <probe_kv>：把 §2.1 的 KV 输出解析进 PROBE_* 全局
PROBE_STATUS=""
PROBE_ROOT=""
PROBE_STATE=""
PROBE_REASON=""
_hf_machines_probe_fields() {
  local kv="${1-}"
  PROBE_STATUS="$(machines_kv_get "${kv}" HF_STATUS)"
  PROBE_ROOT="$(machines_kv_get "${kv}" HF_ROOT)"
  PROBE_STATE="$(machines_kv_get "${kv}" HF_STATE_DIR)"
  if [[ -z "${PROBE_STATE}" ]]; then
    PROBE_STATE="$(machines_kv_get "${kv}" HF_DEFAULT_STATE)"
  fi
  PROBE_REASON="$(machines_kv_get "${kv}" HF_REASON)"
}

# _hf_confirm <prompt> -> stdout yes|no：交互终端单键确认（安全默认 no；非终端恒 no）
_hf_confirm() {
  local prompt="${1-}"
  if [[ ! -t 0 ]]; then
    printf 'no\n'
    return 0
  fi
  printf '%s ' "${prompt}" >&2
  local ans=""
  set +o errexit
  IFS= read -r -n 1 ans
  set -o errexit
  printf '\n' >&2
  if [[ ${ans} == "y" || ${ans} == "Y" ]]; then
    printf 'yes\n'
  else
    printf 'no\n'
  fi
}

# _hf_remote_run <target> <timeout_s> <remote_cmd>：非交互 ssh（BatchMode，沿用用户 ssh 配置）
#   输出原样透传到 stdout，返回 ssh 的退出码。
_hf_remote_run() {
  local target="${1-}"
  local secs="${2-}"
  local remote="${3-}"
  local dest=""
  dest="$(bridge_ssh_destination "${target}")"
  local -a args=(-n -o BatchMode=yes -o ConnectTimeout=10)
  if [[ -n ${HERDR_FORWARD_SSH_CONFIG:-} ]]; then
    args=(-F "${HERDR_FORWARD_SSH_CONFIG}" "${args[@]}")
  fi
  local rc=0
  set +o errexit
  _bridge_bounded "${secs}" ssh "${args[@]}" "${dest}" "${remote}"
  rc=$?
  set -o errexit
  return "${rc}"
}

# _hf_remote_herdr_cmd <herdr 参数串> -> stdout: 远端命令（herdr 不在非交互 PATH 时补 ~/.local/bin）
_hf_remote_herdr_cmd() {
  local rest="${1-}"
  # shellcheck disable=SC2016 # $HOME/$PATH 必须由远端 shell 展开
  printf 'if command -v herdr >/dev/null 2>&1; then herdr %s; else PATH="$HOME/.local/bin:$PATH" herdr %s; fi\n' "${rest}" "${rest}"
}

# _hf_remote_install <target>：在远端执行 herdr plugin install（仅在用户同意后调用）
_hf_remote_install() {
  local target="${1-}"
  local src="${HERDR_FORWARD_INSTALL_SOURCE:-zzjcool/herdr-forward}"
  local q_src="" remote=""
  q_src="$(_bridge_sq "${src}")"
  remote="$(_hf_remote_herdr_cmd "plugin install ${q_src} --yes")"
  printf '正在 %s 上安装插件（herdr plugin install %s --yes；首次需要 git clone，约半分钟）…\n' "${target}" "${src}"
  local rc=0
  set +o errexit
  _hf_remote_run "${target}" 300 "${remote}" 2>&1 | sed 's/^/  │ /'
  rc="${PIPESTATUS[0]}"
  set -o errexit
  return "${rc}"
}

# _hf_remote_setup_ui <target> <root> <state>：让远端的键位立即可用
#   herdr 不把 client 的自定义命令键位带到远端（「Local custom command keybindings are
#   not sent」），A 查看 B 时 prefix+f 找的是 **B 自己 config** 里的绑定。B 的 startup
#   hook 会在 B 的 server 下次启动时自动装，这里立刻代跑一次，再让 B 的 server 重载。
_hf_remote_setup_ui() {
  local target="${1-}"
  local root="${2-}"
  local sdir="${3-}"
  local q_root="" q_state="" q_hook="" remote=""
  q_root="$(_bridge_sq "HERDR_PLUGIN_ROOT=${root}")"
  q_state="$(_bridge_sq "HERDR_PLUGIN_STATE_DIR=${sdir}")"
  q_hook="$(_bridge_sq "${root}/scripts/startup-hook.sh")"
  remote="env ${q_root} ${q_state} bash ${q_hook}"
  local out="" rc=0
  set +o errexit
  out="$(_hf_remote_run "${target}" 60 "${remote}" 2>&1)"
  rc=$?
  set -o errexit
  if ((rc != 0)); then
    printf '  ⚠ 远端键位配置未完成（rc=%s）；可在 %s 上手动运行 %s/scripts/bootstrap.sh。\n' "${rc}" "${target}" "${root}"
    return 0
  fi
  if [[ ${out} == *"键位已就绪"* ]]; then
    local reload=""
    reload="$(_hf_remote_herdr_cmd "server reload-config")"
    set +o errexit
    _hf_remote_run "${target}" 30 "${reload}" >/dev/null 2>&1
    rc=$?
    set -o errexit
    if ((rc == 0)); then
      printf '  远端键位已装好并已重载：查看 %s 时按 prefix+f 打开 Port Forward 面板。\n' "${target}"
    else
      printf '  远端键位已写入；查看 %s 时按 prefix+q（reload config）后即可用 prefix+f。\n' "${target}"
    fi
  elif [[ ${out} == *"已被其它命令占用"* ]]; then
    printf '  ⚠ 远端默认键位 prefix+f 已被占用，未覆盖；请在 %s 上运行 %s/scripts/bootstrap.sh --add-key prefix+<键>。\n' "${target}" "${root}"
  else
    printf '  远端键位已就绪：查看 %s 时按 prefix+f 打开 Port Forward 面板。\n' "${target}"
  fi
  return 0
}

# _hf_bridge_start <id> <target>：启动到该机器的桥接，并停掉指向其它机器的桥接（单 active）
_hf_bridge_start() {
  local id="${1-}"
  local target="${2-}"
  declare -F bridge_up >/dev/null || return 0
  local others="" other=""
  others="$(bridge_clients_json | jq -r --arg id "${id}" '.[] | select(.machine != $id) | .machine')"
  while IFS= read -r other; do
    [[ -n ${other} ]] || continue
    bridge_down "${other}"
  done <<<"${others}"
  local out="" rc=0
  set +o errexit
  out="$(bridge_up "${id}" "${FORWARD_ROOT}/bin/forward" 2>&1)"
  rc=$?
  set -o errexit
  if ((rc == 0)); then
    printf '  %s 在 %s 上登记的端口映射会出现在本机 localhost（forward bridge status 查看）。\n' "${out}" "${target}"
  else
    printf '  ⚠ 桥接未能启动：%s\n' "${out}"
  fi
  return 0
}

cmd_machines_activate() {
  _hf_machines_require

  local arg=""
  local config_override=""
  local install=""
  while (($# > 0)); do
    case "$1" in
    --install | --yes)
      install="yes"
      shift
      ;;
    --no-install)
      install="no"
      shift
      ;;
    --config)
      (($# >= 2)) || die "${EXIT_USAGE}" "--config 需要一个路径值。"
      config_override="$2"
      shift 2
      ;;
    --config=*)
      config_override="${1#*=}"
      shift
      ;;
    -*)
      die "${EXIT_USAGE}" "未知参数：$1。用法：forward machines activate <id|label>"
      ;;
    *)
      if [[ -n "${arg}" ]]; then
        die "${EXIT_USAGE}" "activate 只接受一个 <id|label>（收到额外：$1）。"
      fi
      arg="$1"
      shift
      ;;
    esac
  done

  if [[ -z "${arg}" ]]; then
    die "${EXIT_USAGE}" "缺少 <id|label>。用法：forward machines activate <id|label>（用 'forward machines list' 查看）"
  fi
  if [[ -n "${config_override}" ]]; then
    HERDR_CONFIG_PATH="${config_override}"
    export HERDR_CONFIG_PATH
  fi

  local id=""
  local info=""
  id="$(machines_resolve_id "${arg}")"
  info="$(machines_lookup_json "${id}")"

  local label=""
  local target=""
  label="$(printf '%s' "${info}" | jq -r '.label')"
  target="$(printf '%s' "${info}" | jq -r '.target')"

  local is_local=""
  is_local="$(machines_is_local_target "${target}")"

  # ① 同机短路（§1）：不走 ssh，直接写记录（本机路径已正确，tab bar 无需改）
  if [[ "${is_local}" == "yes" ]]; then
    local local_state=""
    local local_sock=""
    local_state="$(state_dir)"
    local_sock="${HERDR_SOCKET_PATH:-}"
    printf 'machine %s（%s）与当前主机同机，直接标记激活（不发起 SSH 探测）。\n' "${id}" "${target}"
    local rec=""
    rec="$(jq -c -n \
      --arg label "${label}" \
      --arg target "${target}" \
      --arg root "${FORWARD_ROOT}" \
      --arg sd "${local_state}" \
      --arg sock "${local_sock}" \
      '{label: $label, ssh_target: $target, server_root: $root, state_dir: $sd,
        local: true, socket_path: (if $sock == "" then null else $sock end)}')"
    machines_activation_set "${id}" "${rec}"
    printf '已激活（同机）：%s → 本机插件根 %s\n' "${id}" "${FORWARD_ROOT}"
    printf 'tab bar 仍指向本机路径，无需改动；本机路径漂移时重跑本命令即刷新记录。\n'
    return 0
  fi

  # ② 远端：先明示再探测（§5 风险 #1：15s 级耗时必须让用户有预期）
  printf '将只读 SSH 探测 %s（BatchMode，最多约 15 秒）以定位其插件根与 state 目录…\n' "${target}"
  local kv=""
  kv="$(machines_ssh_probe_plugin "${target}")"
  _hf_machines_probe_fields "${kv}"

  # ③' absent + 用户同意 → 代装后重新探测（「递命令不代装」的原则只针对未经同意的情形）
  if [[ ${PROBE_STATUS} == "absent" && ${install} != "no" ]] && declare -F bridge_ssh_destination >/dev/null; then
    if [[ -z ${install} ]]; then
      printf 'SSH 连上了 %s，但该机器上还没有安装 herdr-forward 插件。\n' "${target}" >&2
      install="$(_hf_confirm "现在在 ${target} 上安装吗？（herdr plugin install zzjcool/herdr-forward）[y/N]")"
    fi
    if [[ ${install} == "yes" ]]; then
      local install_rc=0
      set +o errexit
      _hf_remote_install "${target}"
      install_rc=$?
      set -o errexit
      if ((install_rc != 0)); then
        die 4 "在 ${target} 上安装插件失败（rc=${install_rc}）。可手动执行：ssh ${target} 'herdr plugin install zzjcool/herdr-forward --yes'，装好后重跑 forward machines activate ${arg}。"
      fi
      printf '安装完成，重新探测…\n'
      kv="$(machines_ssh_probe_plugin "${target}")"
      _hf_machines_probe_fields "${kv}"
    fi
  fi

  case "${PROBE_STATUS}" in
  present)
    printf '探测命中：插件根 %s\n' "${PROBE_ROOT:-<未报告>}"
    printf '            state 目录 %s\n' "${PROBE_STATE:-<未报告>}"
    if [[ -z "${PROBE_ROOT}" ]]; then
      die 4 "探测到 ${target} 已装插件，但没读到它的插件根（HF_ROOT 为空）：远端 plugins.json / 目录结构异常。请在 ${target} 上执行 'herdr plugin list --json' 核对，或改用 scripts/setup-client.sh --server-host ${target} --server-root <B 的插件根>。"
    fi
    ;;
  absent)
    # ③ absent：给出可直接复制的安装命令，不写记录（保持「递命令不代装」原则）
    printf 'SSH 连上了 %s，但该机器上**没有**安装 herdr-forward 插件。\n' "${target}" >&2
    printf '请在 %s 上执行（本命令不会替你装）：\n' "${target}" >&2
    printf "  ssh %s 'herdr plugin install zzjcool/herdr-forward --yes'\n" "${target}" >&2
    printf '装完后回到本机重跑：forward machines activate %s（或直接 forward machines activate %s --install 让本命令代装）\n' "${arg}" "${arg}" >&2
    die 4 "目标机器未安装 herdr-forward 插件（absent）：${target}。已给出安装命令，装好后重试。"
    ;;
  no-herdr)
    printf 'SSH 连上了 %s，但远端非交互 shell 里找不到 herdr。\n' "${target}" >&2
    printf '排查清单：\n  1) ssh -o BatchMode=yes %s true        # 确认免密与主机名\n' "${target}" >&2
    printf '  2) ssh %s "command -v herdr || ls ~/.local/bin/herdr"   # 确认 herdr 位置\n' "${target}" >&2
    printf '  3) 若 herdr 不在默认 PATH，请在 B 的 ~/.bashrc / profile 里补 PATH 后重试。\n' >&2
    die 4 "远端找不到 herdr 命令（no-herdr）：${target}。${PROBE_REASON:+原因：${PROBE_REASON}}"
    ;;
  *)
    printf 'SSH 探测失败，无法确认 %s 上的插件状态。\n' "${target}" >&2
    printf '排查清单：\n  1) ssh -o BatchMode=yes %s true        # 免密/主机名/端口\n' "${target}" >&2
    printf '  2) 检查 ~/.ssh/config 里的该主机别名与 IdentityFile。\n' >&2
    printf '  3) 内网机请确认已连上 VPN。\n' >&2
    die 4 "无法通过 SSH 到达 ${target}（unreachable）。${PROBE_REASON:+原因：${PROBE_REASON}}"
    ;;
  esac

  # ④ present：写记录 → 装 UI（幂等）→ reload 提示
  local record=""
  record="$(jq -c -n \
    --arg label "${label}" \
    --arg target "${target}" \
    --arg root "${PROBE_ROOT}" \
    --arg sd "${PROBE_STATE}" \
    '{label: $label, ssh_target: $target, server_root: $root, state_dir: $sd, local: false}')"
  machines_activation_set "${id}" "${record}"

  local tb_rc=0
  local keys_rc=0
  set +o errexit
  _hf_install_tabbar "${PROBE_ROOT}" "${PROBE_STATE}"
  tb_rc=$?
  _hf_install_keys
  keys_rc=$?
  set -o errexit

  if [[ "${tb_rc}" -ne 0 ]]; then
    # 冻结退出码表没有「安装器失败」这一档；记录已写、tab bar 未切 = 半成品状态，
    # 用 1（通用失败）显式失败，避免用户以为已生效。可用 deactivate 回滚。
    die 1 "激活记录已写入，但 tab bar 安装器失败（rc=${tb_rc}）。请手动运行 'bash ${FORWARD_ROOT}/scripts/install-tabbar.sh --plugin-root ${PROBE_ROOT} --state-dir ${PROBE_STATE}' 后重试；或用 'forward machines deactivate all' 回滚。"
  fi
  if [[ "${keys_rc}" -ne 0 ]]; then
    log warn "键位安装器返回 ${keys_rc}（tab bar 已切换成功）。可手动运行：bash ${FORWARD_ROOT}/scripts/install-keys.sh"
  fi

  printf '已激活：%s（%s）\n' "${id}" "${target}"
  printf '  tab bar 已指向该机器：%s\n' "${PROBE_ROOT}"
  if declare -F bridge_up >/dev/null; then
    _hf_remote_setup_ui "${target}" "${PROBE_ROOT}" "${PROBE_STATE}"
    _hf_bridge_start "${id}" "${target}"
    printf '  远程开发：在 %s 上按 prefix+f，选中监听端口即映射到本机 localhost（或在那边运行 forward add <端口>）。\n' "${target}"
  fi
  _hf_machines_reload_hint "${target}"
}

# _hf_bridge_stop <id|all>：停桥接（client 侧监听随会话一并释放）；桥接模块缺失时静默
_hf_bridge_stop() {
  local which="${1-}"
  declare -F bridge_down >/dev/null || return 0
  if [[ ${which} == "all" ]]; then
    local mids="" mid=""
    mids="$(bridge_clients_json | jq -r '.[].machine')"
    while IFS= read -r mid; do
      [[ -n ${mid} ]] || continue
      bridge_down "${mid}"
    done <<<"${mids}"
  else
    bridge_down "${which}"
  fi
  return 0
}

cmd_machines_deactivate() {
  _hf_machines_require

  local arg=""
  local config_override=""
  while (($# > 0)); do
    case "$1" in
    --config)
      (($# >= 2)) || die "${EXIT_USAGE}" "--config 需要一个路径值。"
      config_override="$2"
      shift 2
      ;;
    --config=*)
      config_override="${1#*=}"
      shift
      ;;
    -*)
      die "${EXIT_USAGE}" "未知参数：$1。用法：forward machines deactivate <id|all>"
      ;;
    *)
      if [[ -n "${arg}" ]]; then
        die "${EXIT_USAGE}" "deactivate 只接受一个 <id|all>（收到额外：$1）。"
      fi
      arg="$1"
      shift
      ;;
    esac
  done

  if [[ -z "${arg}" ]]; then
    die "${EXIT_USAGE}" "缺少 <id|all>。用法：forward machines deactivate <id|all>（用 'forward machines list' 查看）"
  fi
  if [[ -n "${config_override}" ]]; then
    HERDR_CONFIG_PATH="${config_override}"
    export HERDR_CONFIG_PATH
  fi

  local active=""
  active="$(machines_activation_active)"

  if [[ "${arg}" == "all" ]]; then
    # all：清 active + 删全部记录（§2.3「all 清空并删全部记录」）→ 回到初始态
    machines_activation_reset
    _hf_bridge_stop all
    printf '已停用全部 machine 并清空激活记录。\n'
  else
    local id=""
    id="$(machines_resolve_id "${arg}")"
    # 记录必须存在，否则用户打错 id 会静默「成功」
    machines_activation_get "${id}" >/dev/null
    _hf_bridge_stop "${id}"

    if [[ "${active}" != "${id}" ]]; then
      # 非当前 active：只想清掉这台的历史记录（tab bar 不动）
      machines_activation_remove "${id}"
      printf '已删除 %s 的激活记录（它本就不是当前 active）。\n' "${id}"
      if [[ -n "${active}" ]]; then
        printf '当前 active 仍是 %s，tab bar 保持指向它。\n' "${active}"
        printf '如需停用它：forward machines deactivate %s\n' "${active}"
      fi
      return 0
    fi

    # 当前 active：只清 active，记录保留为 [·] 历史（§1「deactivate 清 active」）
    machines_activation_clear_active
    printf '已停用 %s（记录保留，可用 forward machines activate %s 重新激活）。\n' "${id}" "${arg}"
  fi

  # 恢复本机路径：不传 --plugin-root，install-tabbar 自动解析本脚本所在插件根
  local tb_rc=0
  set +o errexit
  _hf_install_tabbar
  tb_rc=$?
  set -o errexit
  if [[ "${tb_rc}" -ne 0 ]]; then
    die 1 "激活状态已清空，但 tab bar 恢复本机路径失败（rc=${tb_rc}）。请手动运行 'bash ${FORWARD_ROOT}/scripts/install-tabbar.sh' 恢复；tab bar 为空时不影响其他功能。"
  fi

  printf 'tab bar 已恢复为本机路径：%s\n' "${FORWARD_ROOT}"
  _hf_machines_reload_hint "本机"
}

cmd_machines_doctor() {
  _hf_machines_require

  local config_override=""
  while (($# > 0)); do
    case "$1" in
    --config)
      (($# >= 2)) || die "${EXIT_USAGE}" "--config 需要一个路径值。"
      config_override="$2"
      shift 2
      ;;
    --config=*)
      config_override="${1#*=}"
      shift
      ;;
    -*)
      die "${EXIT_USAGE}" "未知参数：$1。用法：forward machines doctor"
      ;;
    *)
      die "${EXIT_USAGE}" "doctor 不接受位置参数：$1。"
      ;;
    esac
  done
  if [[ -n "${config_override}" ]]; then
    HERDR_CONFIG_PATH="${config_override}"
    export HERDR_CONFIG_PATH
  fi

  local active=""
  active="$(machines_activation_active)"
  if [[ -z "${active}" ]]; then
    printf '没有处于激活状态的 machine（tab bar 指向本机路径），无需检查。\n'
    printf '  列出可用机器：forward machines list\n'
    return 0
  fi

  local rec=""
  rec="$(machines_activation_get "${active}")"
  local label=""
  local target=""
  local saved_root=""
  local saved_state=""
  local rec_local=""
  label="$(printf '%s' "${rec}" | jq -r '.label // ""')"
  target="$(printf '%s' "${rec}" | jq -r '.ssh_target // ""')"
  saved_root="$(printf '%s' "${rec}" | jq -r '.server_root // ""')"
  saved_state="$(printf '%s' "${rec}" | jq -r '.state_dir // ""')"
  rec_local="$(printf '%s' "${rec}" | jq -r 'if .local == true then "yes" else "no" end')"

  printf '当前 active：%s（%s）\n' "${active}" "${label}"
  printf '  ssh_target  : %s\n' "${target}"
  printf '  server_root : %s\n' "${saved_root:-<未记录>}"
  printf '  state_dir   : %s\n' "${saved_state:-<未记录>}"

  # 同机记录：无需 ssh，只检查记录路径是否与本机一致（路径漂移 = 本机重装/移动检出）
  if [[ "${rec_local}" == "yes" ]]; then
    printf '  类型        : 同机（local）\n'
    if [[ "${saved_root}" != "${FORWARD_ROOT}" ]]; then
      printf '发现路径漂移：记录的插件根 %s 与当前检出 %s 不一致。\n' "${saved_root}" "${FORWARD_ROOT}"
      local rec2=""
      local now_state=""
      now_state="$(state_dir)"
      rec2="$(printf '%s' "${rec}" | jq -c --arg r "${FORWARD_ROOT}" --arg s "${now_state}" '.server_root = $r | .state_dir = $s')"
      machines_activation_set "${active}" "${rec2}"
      printf '已更新记录为当前检出（tab bar 本就指向本机，无需改动）。\n'
      return 0
    fi
    printf '记录与当前检出一致，无需修复。\n'
    return 0
  fi

  # 桥接：远端 active 机器应当有一条在跑的桥接；没跑就拉起来（supervisor 自带断线重连）
  if declare -F bridge_running >/dev/null; then
    local br_running="" br_state=""
    br_running="$(bridge_running "${active}")"
    if [[ ${br_running} == "yes" ]]; then
      br_state="$(bridge_clients_json | jq -r --arg id "${active}" \
        'first(.[] | select(.machine == $id) | "\(.state)\(if (.reason // "") != "" and .state != "connected" then "（" + .reason + "）" else "" end)") // "?"')"
      printf '  bridge      : 运行中，%s\n' "${br_state}"
    else
      printf '  bridge      : 未运行，正在启动…\n'
      _hf_bridge_start "${active}" "${target}"
    fi
  fi

  # 远端记录：重探测（只读）。stale 路径 -> 重写记录 + 重写 tab bar；unreachable -> 只报告。
  printf '\n正在重新探测 %s（只读，最多约 15 秒）…\n' "${target}"
  local kv=""
  kv="$(machines_ssh_probe_plugin "${target}")"
  _hf_machines_probe_fields "${kv}"

  case "${PROBE_STATUS}" in
  present)
    if [[ -z "${PROBE_ROOT}" ]]; then
      printf '记录 stale：探测到插件但没读到插件根，无法自动修复。\n'
      printf '  下一步：ssh %s "herdr plugin list --json"\n' "${target}"
      die 4 "active machine ${active} 的插件根无法确认（HF_ROOT 为空）。记录保持原样，未改动 config。"
    fi
    printf '  重探测插件根: %s\n' "${PROBE_ROOT}"
    printf '  重探测 state: %s\n' "${PROBE_STATE:-<未报告>}"
    if [[ "${PROBE_ROOT}" == "${saved_root}" && "${PROBE_STATE}" == "${saved_state}" ]]; then
      printf '记录与远端一致，无需修复。\n'
      return 0
    fi
    printf '发现 stale 路径（远端已漂移）：记录 %s / 实测 %s\n' "${saved_root}" "${PROBE_ROOT}"
    local rec3=""
    rec3="$(printf '%s' "${rec}" | jq -c --arg r "${PROBE_ROOT}" --arg s "${PROBE_STATE}" '.server_root = $r | .state_dir = $s')"
    machines_activation_set "${active}" "${rec3}"
    printf '已更新激活记录。\n'
    local tb_rc=0
    set +o errexit
    _hf_install_tabbar "${PROBE_ROOT}" "${PROBE_STATE}"
    tb_rc=$?
    set -o errexit
    if [[ "${tb_rc}" -ne 0 ]]; then
      die 1 "记录已更新，但 tab bar 重写失败（rc=${tb_rc}）。请手动运行 'bash ${FORWARD_ROOT}/scripts/install-tabbar.sh --plugin-root ${PROBE_ROOT} --state-dir ${PROBE_STATE}'。"
    fi
    printf 'tab bar 已按新路径重写。\n'
    _hf_machines_reload_hint "${target}"
    ;;
  absent)
    printf '远端 %s 上已找不到该插件（可能被卸载）。\n' "${target}"
    printf '  下一步：在 %s 上重装（ssh %s '"'"'herdr plugin install zzjcool/herdr-forward --yes'"'"'）\n' "${target}" "${target}"
    printf '  或停用：forward machines deactivate %s\n' "${active}"
    die 4 "active machine ${active} 的远端已卸载插件（absent）。记录与 config 保持原样，未改动。"
    ;;
  no-herdr | unreachable)
    # 关键：连不上时**不动** config 与记录（stale 报告，不误删 —— §2.3 doctor 契约）
    printf '远端暂不可达/无法判定（%s）：%s\n' "${PROBE_STATUS}" "${PROBE_REASON:-无更多信息}"
    printf '记录与 config 均保持原样（不做任何破坏性修复）。\n'
    printf '  排查：ssh -o BatchMode=yes %s true\n' "${target}"
    printf '  网络恢复后重跑：forward machines doctor\n'
    die 4 "active machine ${active} 暂不可达（${PROBE_STATUS}），已按 stale 报告（未改动任何文件）。"
    ;;
  *)
    printf '探测返回未知状态（%s），记录与 config 保持原样。\n' "${PROBE_STATUS:-<empty>}"
    die 4 "active machine ${active} 的探测状态未知：${PROBE_STATUS:-<empty>}。"
    ;;
  esac
}

cmd_machines() {
  if (($# == 0)); then
    die "${EXIT_USAGE}" "缺少 machines 子命令。用法：forward machines list|activate|deactivate|doctor（'forward --help' 查看）"
  fi

  local sub="$1"
  shift
  case "${sub}" in
  list) cmd_machines_list "$@" ;;
  activate) cmd_machines_activate "$@" ;;
  deactivate) cmd_machines_deactivate "$@" ;;
  doctor) cmd_machines_doctor "$@" ;;
  help | --help | -h)
    printf '用法：forward machines <list|activate|deactivate|doctor>\n'
    printf '  list [--json] [--short]      列出 saved machines 与激活状态\n'
    printf '  activate <id|label> [--install]  激活（远端先只读 SSH 探测；未装插件可代装）并启动桥接\n'
    printf '  deactivate <id|all>         停用并把 tab bar 恢复本机路径\n'
    printf '  doctor                      重探测 active 机器（stale 路径检测）\n'
    ;;
  -*)
    die "${EXIT_USAGE}" "未知参数：${sub}。用法：forward machines list|activate|deactivate|doctor"
    ;;
  *)
    die "${EXIT_USAGE}" "未知 machines 子命令：${sub}。可用：list / activate / deactivate / doctor。"
    ;;
  esac
}

# --- dispatch ---

main() {
  if (($# == 0)); then
    usage >&2
    die "${EXIT_USAGE}" "缺少子命令。请从 add / list / remove / doctor 中选择（'forward --help' 查看全部）。"
  fi

  # --- W4 迁移接线（PLAN-GO-MIGRATION §6/§10）：已迁移子命令交给 Go 实现 ---
  # 只有本块允许在迁移期改动（见 PLAN §3 的 bin/forward dispatch 边界）。
  # 条件式而非无条件 exec：
  #   * 单元/集成测试会把 bin/forward + lib/ 拷成「staged root」，那里没有
  #     forward-go —— 无条件 exec 会 127 直接弄红 ci.sh；
  #   * 回滚方案就是删掉这个 if 块（bash 立即恢复全权处理 list/ports）。
  # 目标复用 bin/forward-go（构建产物，.gitignore 排除；见 Makefile 的 build 目标与
  # scripts/e2e 的容器内构建）。
  case "${1-}" in
  list | ports)
    if [[ -x "${FORWARD_ROOT}/bin/forward-go" ]]; then
      exec "${FORWARD_ROOT}/bin/forward-go" "$@"
    fi
    ;;
  *) ;;
  esac

  local subcmd="$1"
  shift

  case "${subcmd}" in
  add) cmd_add "$@" ;;
  list) cmd_list "$@" ;;
  remove) cmd_remove "$@" ;;
  doctor) cmd_doctor "$@" ;;
  publish) cmd_publish "$@" ;;
  unpublish) cmd_unpublish "$@" ;;
  watch) cmd_watch "$@" ;;
  bootstrap) cmd_bootstrap "$@" ;;
  machines) cmd_machines "$@" ;;
  bridge) cmd_bridge "$@" ;;
  ports) cmd_ports "$@" ;;
  open-url) cmd_open_url "$@" ;;
  help | --help | -h)
    usage
    return 0
    ;;
  *)
    usage >&2
    die "${EXIT_USAGE}" "未知子命令：${subcmd}。请运行 'forward --help' 查看可用子命令。"
    ;;
  esac
}

main "$@"
